# Database name — REQUIRED
# This single value derives all GraphQL endpoints:
#   admin-{db}.localhost:3000  → organizations, members, permissions
#   auth-{db}.localhost:3000   → users, authentication
#   api-{db}.localhost:3000   → your business data
NEXT_PUBLIC_DB_NAME=myapp

# Optional: Override the default API port (default: 3000)
# NEXT_PUBLIC_API_PORT=3000

# Optional: Override individual endpoints (bypasses DB_NAME derivation)
# NEXT_PUBLIC_ADMIN_ENDPOINT=http://admin-mydb.localhost:3000/graphql
# NEXT_PUBLIC_AUTH_ENDPOINT=http://auth-mydb.localhost:3000/graphql
# NEXT_PUBLIC_APP_ENDPOINT=http://api-mydb.localhost:3000/graphql

# -----------------------------------------------------------------------------
# Provisioning variables (set by create-db, read by provision/seed scripts)
# -----------------------------------------------------------------------------
# Root metaschema endpoints
API_ENDPOINT=http://api.localhost:3000/graphql
AUTH_ENDPOINT=http://auth.localhost:3000/graphql
# Modules API endpoint — blueprint, constructBlueprint, databaseProvisionModule
MODULES_ENDPOINT=http://modules.localhost:3000/graphql

# Database configuration
DATABASE_NAME=myapp
ADMIN_EMAIL=admin@myapp.local
ADMIN_PASSWORD=Password123!

# Populated after create-db
ACCESS_TOKEN=
DATABASE_ID=

# -----------------------------------------------------------------------------
# GraphQL export variables
# -----------------------------------------------------------------------------
# Override endpoints for pgpm export:graphql
# META_ENDPOINT=http://modules.localhost:3000/graphql
# MIGRATE_ENDPOINT=http://migrate-myapp.localhost:3000/graphql
# DB_AUTH_ENDPOINT=http://auth-myapp.localhost:3000/graphql
# Extension names for the exported modules
# EXTENSION_NAME=myapp
# META_EXTENSION_NAME=myapp-service

# Postgres (set by pgpm env or manually)
# NOTE: PGDATABASE is the ONE physical platform DB — 'constructive', NOT the
# tenant name. Schema-based tenancy: the myapp_* tenant schemas live inside it.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=constructive

# -----------------------------------------------------------------------------
# OAuth / SSO
# -----------------------------------------------------------------------------
# OAUTH_ENABLED must be true for the CNC server to mount /auth/* routes.
# Without this, the server starts but /auth/providers returns 404.
OAUTH_ENABLED=true

# OAuth state secret — REQUIRED for SSO. Generate with: openssl rand -hex 32
# The CNC GraphQL server reads this via OAUTH_STATE_SECRET env var.
# Dev default (same value create-db writes) — replace with your own for prod.
OAUTH_STATE_SECRET=sso-e2e-dev-state-secret-at-least-32-bytes-long

# -----------------------------------------------------------------------------
# Identity provider (read by packages/provision/src/oauth.ts at provision time)
# -----------------------------------------------------------------------------
# Defaults point at the LOCAL mock OAuth server (:4010) — no real OAuth app
# needed for development. To test against a REAL provider (e.g. Google), set
# the OAUTH_* vars to your app's credentials and URLs. The GraphQL server
# reads ONLY the DB rows; these vars inject the credentials at provision time.
#
# Google OAuth callback URI to register in the Google Cloud Console:
#   http://auth-{db}.localhost:3000/auth/google/callback
# NOTE: Google only allows http://localhost (exact host) redirect URIs over
# plain HTTP; other hosts need HTTPS. If Google rejects the callback with
# redirect_uri_mismatch, use the mock provider or set up HTTPS.
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=constructive-sso-local-client
OAUTH_CLIENT_SECRET=constructive-sso-local-secret
OAUTH_AUTHORIZE_URL=http://localhost:4010/authorize
OAUTH_TOKEN_URL=http://localhost:4010/token
OAUTH_USERINFO_URL=http://localhost:4010/userinfo
OAUTH_PKCE_ENABLED=true
OAUTH_SCOPES=openid,email,profile

# Real Google example (uncomment + fill in):
# OAUTH_PROVIDER=google
# OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# OAUTH_CLIENT_SECRET=GOCSPX-xxxx
# OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Production cookie settings (local dev keeps host-only cookie + HTTP):
# COOKIE_DOMAIN=.<real-domain>
# COOKIE_SECURE=true
# OAUTH_REQUIRE_VERIFIED_EMAIL=true

# Mock OAuth server (for local SSO testing WITHOUT a real provider)
# Started automatically by local-bringup.sh (step 4.5) or run manually: pnpm mock-oauth
OAUTH_MOCK_PORT=4010
OAUTH_MOCK_HOST=0.0.0.0
OAUTH_TEST_SUB=sso-test-user
OAUTH_TEST_EMAIL=sso-test-user@example.test
