# constructive-sso — cloud-function SSO (compute sync gateway)
#
# Copy this file to .env and fill in your values. .env is gitignored and must
# NEVER be committed — it holds your real OAuth client secret.
#
# Architecture: `fun up --k8s --alt-ports` (in the constructive-db repo)
# brings up ONE platform database — constructive-functions-db1, port-forwarded
# to :15432. The tenant is provisioned INSIDE it (pnpm create-db). There is no
# second database and no cnc GraphQL server.

# -----------------------------------------------------------------------------
# Platform database (the k8s platform DB from `fun up --k8s --alt-ports`)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=15432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=constructive-functions-db1

# -----------------------------------------------------------------------------
# Tenant provisioning (read by packages/provision/src/provision-tenant.ts)
# -----------------------------------------------------------------------------
# The tenant's name and the host its routes bind on.
DATABASE_NAME=myapp
SSO_ROUTE_HOST=localhost

# Populated by `pnpm create-db` — do not set manually.
DATABASE_ID=

# -----------------------------------------------------------------------------
# Cloud-function SSO lane (read by configure-sso.ts + the Next.js BFF)
# -----------------------------------------------------------------------------
# The compute sync gateway (Traefik -> compute-sync on port 80).
SSO_GATEWAY_URL=http://localhost

# This app's own origin — where Google's redirect lands. Must be plain
# http://localhost:3000 for Google's plain-HTTP redirect rule.
APP_ORIGIN=http://localhost:3000

# Identity provider credentials (read by configure-sso.ts at provision time —
# they are written into the tenant's provider row + encrypted secret store).
# Register this EXACT redirect URI in the Google Cloud Console OAuth client:
#   http://localhost:3000/auth/google/callback
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_SCOPES=openid,email,profile

# -----------------------------------------------------------------------------
# Same-origin GraphQL proxy (src/app/api/graphql/[ctx]) — OPTIONAL
# -----------------------------------------------------------------------------
# Only needed if you use the email/password GraphQL lanes beside SSO. The
# session cookie is host-only on localhost and cannot reach *.localhost hosts
# directly, so the BFF proxies these upstreams server-side.
# GRAPHQL_ADMIN_URL=http://admin-myapp.localhost/graphql
# GRAPHQL_AUTH_URL=http://auth-myapp.localhost/graphql
# GRAPHQL_APP_URL=http://api-myapp.localhost/graphql

# -----------------------------------------------------------------------------
# App UI (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DB_NAME=myapp
# Optional: override the dev server port (default: 3000)
# NEXT_PUBLIC_API_PORT=3000
