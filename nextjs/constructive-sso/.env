# OAuth / SSO — dev-only secret for OAuth state signing (HMAC-SHA256)
# OAUTH_ENABLED must be true for the CNC server to mount /auth/* routes
OAUTH_ENABLED=true
OAUTH_STATE_SECRET=sso-e2e-dev-state-secret-at-least-32-bytes-long

# Mock OAuth server (for local SSO testing)
# Started automatically by local-bringup.sh (step 4.5) or run manually: pnpm mock-oauth
OAUTH_MOCK_PORT=4010
OAUTH_MOCK_HOST=0.0.0.0
OAUTH_TEST_SUB=sso-test-user
OAUTH_TEST_EMAIL=sso-test-user@example.test
