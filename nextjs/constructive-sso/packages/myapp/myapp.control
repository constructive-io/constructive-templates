# myapp extension
comment = 'myapp extension'
default_version = '0.0.1'
module_pathname = '$libdir/myapp'
requires = 'errors,metaschema-modules,metaschema-schema,pgpm-database-jobs,pgpm-inflection,pgpm-jwt-claims,pgpm-stamps,pgpm-types,pgpm-utils,pgpm-verify,services'
relocatable = false
superuser = false
